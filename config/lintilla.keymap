#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        sl_mod: sl_mod {
            compatible = "zmk,behavior-sticky-key";
            bindings = <&mo>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            ignore-modifiers;
        };

        bt_sel_0: bt_select_0 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 0>, <&bt_clr 0>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        bt_sel_1: bt_select_1 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 1>, <&bt_clr 1>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        bt_sel_2: bt_select_2 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 2>, <&bt_clr 2>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        bt_sel_3: bt_select_3 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 3>, <&bt_clr 3>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        bt_sel_4: bt_select_4 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 4>, <&bt_clr 4>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        out_tog: out_toggle {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&out OUT_TOG>, <&out OUT_USB>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&caps_word>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        win_ae: win_ae {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_ae_low>, <&win_ae_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_ie: win_ie {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_ie_low>, <&win_ie_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_oe: win_oe {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_oe_low>, <&win_oe_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_ue: win_ue {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_ue_low>, <&win_ue_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_agrave: win_agrave {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_agrave_low>, <&win_agrave_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_eaigu: win_eaigu {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_eaigu_low>, <&win_eaigu_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_dash: win_dash {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&win_emdash>, <&win_endash>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        linux_ae: linux_ae {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&linux_ae_low>, <&linux_ae_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        linux_ie: linux_ie {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&linux_ie_low>, <&linux_ie_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        linux_oe: linux_oe {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&linux_oe_low>, <&linux_oe_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        linux_ue: linux_ue {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&linux_ue_low>, <&linux_ue_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        linux_agrave: linux_agrave {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&linux_agrave_low>, <&linux_agrave_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        linux_eaigu: linux_eaigu {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&linux_eaigu_low>, <&linux_eaigu_up>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        linux_dash: linux_dash {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&linux_emdash>, <&linux_endash>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    macros {
        bt_sel: bt_select {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&out OUT_BLE &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
        };

        bt_clr: bt_clear {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER &bt BT_CLR>;
        };

        win_ellipsis: win_ellipsis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N3 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ae_low: win_ae_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N8>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ae_up: win_ae_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N9 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_oe_low: win_oe_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_oe_up: win_oe_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N1 &kp KP_N4>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ue_low: win_ue_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N5 &kp KP_N2>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ue_up: win_ue_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N0>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ie_low: win_ie_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N9>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ie_up: win_ie_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N0 &kp KP_N7>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_eaigu_low: win_eaigu_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_eaigu_up: win_eaigu_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N0 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_agrave_low: win_agrave_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N4>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_agrave_up: win_agrave_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N9 &kp KP_N2>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_sz: win_sz {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_ostroke: win_ostroke {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N8>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_emdash: win_emdash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N5 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_endash: win_endash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N5 &kp KP_N0>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_euro: win_euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N2 &kp KP_N8>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_deg: win_deg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N7 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_qo: win_qo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N7 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>;
        };

        win_qc: win_qc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N8 &kp KP_N7>,
                <&macro_release>,
                <&kp LALT>;
        };

        linux_ellipsis: linux_ellipsis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp DOT &kp DOT>;
        };

        linux_ae_low: linux_ae_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp A &kp DQT>;
        };

        linux_ae_up: linux_ae_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp RALT &kp LS(A) &kp DQT>;
        };

        linux_oe_low: linux_oe_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp O &kp DQT>;
        };

        linux_oe_up: linux_oe_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp RALT &kp LS(O) &kp DQT>;
        };

        linux_ue_low: linux_ue_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp U &kp DQT>;
        };

        linux_ue_up: linux_ue_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp RALT &kp LS(U) &kp DQT>;
        };

        linux_ie_low: linux_ie_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp I &kp DQT>;
        };

        linux_ie_up: linux_ie_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp RALT &kp LS(I) &kp DQT>;
        };

        linux_eaigu_low: linux_eaigu_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp E &kp SQT>;
        };

        linux_eaigu_up: linux_eaigu_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp RALT &kp LS(E) &kp SQT>;
        };

        linux_agrave_low: linux_agrave_low {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp A &kp GRAVE>;
        };

        linux_agrave_up: linux_agrave_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp RALT &kp LS(A) &kp GRAVE>;
        };

        linux_sz: linux_sz {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp S &kp S>;
        };

        linux_ostroke: linux_ostroke {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp O &kp FSLH>;
        };

        linux_emdash: linux_emdash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp MINUS &kp MINUS &kp MINUS>;
        };

        linux_endash: linux_endash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp RALT &kp MINUS &kp MINUS &kp DOT>;
        };

        linux_euro: linux_euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp E &kp EQUAL>;
        };

        linux_deg: linux_deg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp O &kp O>;
        };

        linux_qo: linux_qo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp LT &kp LT>;
        };

        linux_qc: linux_qc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RALT &kp GT &kp GT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_LBKT {
            bindings = <&hm LC(LSHFT) LBKT>;
            key-positions = <17 18>;
            layers = <0>;
            timeout-ms = <20>;
        };

        combo_minus {
            bindings = <&hm LC(LSHFT) MINUS>;
            key-positions = <21 22>;
            layers = <0>;
            timeout-ms = <20>;
        };

        combo_elipse {
            bindings = <&linux_ellipsis>;
            key-positions = <33 34>;
            layers = <0>;
        };

        combo_mb4 {
            bindings = <&mkp MB4>;
            key-positions = <21 22>;
            layers = <1>;
        };

        combo_mb5 {
            bindings = <&mkp MB5>;
            key-positions = <23 24>;
            layers = <1>;
        };

        combo_winelipse {
            bindings = <&win_ellipsis>;
            key-positions = <33 34 32>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        alphas {
            bindings = <
           &none                                                                                                                                                        &none
&sl_mod 7  &kp Q       &kp W       &kp F        &kp P        &kp B                                                   &kp J      &kp L        &kp U        &kp Y         &kp SQT     &sl_mod 7
&sl_mod 6  &hm LGUI A  &hm LALT R  &hm LCTRL S  &hm LSHFT T  &kp G                                                   &kp M      &hm LSHFT N  &hm LCTRL E  &hm LALT I    &hm LGUI O  &sl_mod 6
           &kp Z       &hm RALT X  &kp C        &kp D        &kp V                                                   &kp K      &kp H        &kp COMMA    &hm RALT DOT  &kp FSLH
                                                             &lt 2 TAB  &lt 1 SPC  &lt 1 ESC  &lt 5 DEL  &lt 3 BSPC  &lt 4 RET
            >;

            label = "Colemak-dh";
        };

        nav {
            bindings = <
       &none                                                                                                                                  &none
&none  &none     &none     &none      &none      &none                                   &kp LC(Z)     &kp LS(INS)  &kp LC(INS)  &kp LS(DEL)  &kp LC(A)  &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none                                   &u_caps_word  &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT  &none
       &none     &kp RALT  &none      &none      &none                                   &kp INS       &kp HOME     &kp PG_DN    &kp PG_UP    &kp END
                                                 &none  &none  &none  &kp DEL  &kp BSPC  &kp RET
            >;

            label = "Navigation";
        };

        media {
            bindings = <
       &none                                                                                                                                    &none
&none  &none     &none     &none      &none      &none                                      &none       &ind_bat    &ind_con      &none         &none       &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none                                      &none       &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &none
       &none     &kp RALT  &none      &none      &none                                      &out_tog    &bt_sel_0   &bt_sel_1     &bt_sel_2     &bt_sel_3
                                                 &none  &none  &none  &kp C_STOP  &kp C_PP  &kp C_MUTE
            >;

            label = "Media";
        };

        num {
            bindings = <
       &none                                                                                                                 &none
&none  &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT                                    &none  &none      &none      &none     &none     &none
&none  &kp SEMI   &kp N4  &kp N5  &kp N6  &kp EQUAL                                   &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
       &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp BSLH                                    &none  &none      &none      &kp RALT  &none
                                          &kp DOT    &kp N0  &kp MINUS  &none  &none  &none
            >;

            label = "Numbers";
        };

        sym {
            bindings = <
       &none                                                                                                                          &none
&none  &kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR   &kp RBRC                                     &none  &none      &none      &none     &none     &none
&none  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS                                     &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
       &kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE                                     &none  &none      &none      &kp RALT  &none
                                                  &kp LPAR  &kp RPAR  &kp UNDER  &none  &none  &none
            >;

            label = "Sympols";
        };

        fun {
            bindings = <
       &none                                                                                                                              &none
&none  &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN                                                  &none  &none      &none      &none     &none     &none
&none  &kp F11  &kp F4  &kp F5  &kp F6  &kp SLCK                                                   &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
       &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK                                            &none  &none      &none      &kp RALT  &none
                                        &kp TAB          &kp SPC  &kp K_APPLICATION  &none  &none  &none
            >;

            label = "Function";
        };

        lang {
            bindings = <
       &none                                                                                                                                      &none
&none  &none          &none        &none      &linux_ostroke  &none                                    &none  &none      &linux_ue     &none      &linux_deg  &none
&none  &linux_ae      &linux_euro  &linux_sz  &kp LSHFT       &none                                    &none  &kp LSHFT  &linux_eaigu  &linux_ie  &linux_oe   &none
       &linux_agrave  &none        &none      &none           &none                                    &none  &none      &linux_qo     &linux_qc  &none
                                                              &none  &linux_dash  &none  &none  &none  &none
            >;

            label = "Language";
        };

        win_lang {
            bindings = <
       &none                                                                                                                        &none
&none  &none        &none      &none    &win_ostroke  &none                                  &none  &none      &win_ue     &none    &win_deg  &none
&none  &win_ae      &win_euro  &win_sz  &kp LSHFT     &none                                  &none  &kp LSHFT  &win_eaigu  &win_ie  &win_oe   &none
       &win_agrave  &none      &none    &none         &none                                  &none  &none      &win_qo     &win_qc  &none
                                                      &none  &win_dash  &none  &none  &none  &none
            >;

            label = "Windows Language";
        };
    };
};

